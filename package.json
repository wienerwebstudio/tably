{
  "name": "tapperl",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "build": "pnpm run build:packages && pnpm -r --filter './apps/*' run build",
    "dev": "pnpm run build:packages && pnpm -r --parallel --filter './apps/*' run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @tapperl/database run generate",
    "db:migrate": "pnpm --filter @tapperl/database run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @tapperl/database run migrate:dev",
    "db:seed": "pnpm --filter @tapperl/api run seed",
    "db:seed:demo": "pnpm --filter @tapperl/api run seed:demo"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "@nestjs/core",
      "esbuild",
      "sharp",
      "@node-rs/argon2",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
