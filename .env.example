# ── Basis ────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://tably:tably@localhost:5432/tably
REDIS_URL=redis://localhost:6379
# bullmq (braucht Redis) oder inline (Jobs laufen im API-Prozess)
QUEUE_DRIVER=bullmq
API_PORT=4000
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# 64 Hex-Zeichen. Erzeugen mit: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Nur für Entwicklung/Tests: simulierte NFC-Stempel erlauben
NFC_SIMULATOR_ENABLED=true
COOKIE_SECURE=false
# Nur für automatisierte Tests (E2E); in Produktion verboten
RATE_LIMIT_DISABLED=false
TRUST_PROXY=false

# ── Super-Admin (wird beim Seed angelegt) ────────────────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── E-Mail (leer = lokaler Testmodus, Mails landen im Testpostfach) ──────
SMTP_URL=
MAIL_FROM="Tably <no-reply@example.com>"

# ── Stripe (leer = lokaler Testmodus ohne echte Zahlungen) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Apple Wallet (leer = deaktiviert) ────────────────────────────────────
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=

# ── Google Wallet (leer = deaktiviert) ───────────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
