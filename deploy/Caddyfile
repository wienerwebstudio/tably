{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$WEB_HOST} {
	import common
	reverse_proxy web:3000
}

{$DASHBOARD_HOST} {
	import common
	reverse_proxy dashboard:3001
}

{$API_HOST} {
	import common
	reverse_proxy api:4000
}
